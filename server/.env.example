# Chép thành server/.env và điền giá trị
# PORT của backend (HTTP)
PORT=3000

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy (không dấu cách đầu)
# Ví dụ dev: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Để trống (không đặt) = cho phép mọi origin (chỉ dùng môi trường dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# (Bắt buộc) Connection string MongoDB Atlas — đọc bằng MONGODB_URI khi server khởi động
# Dạng: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/photobooth?retryWrites=true&w=majority
# Server KHÔNG khởi động nếu MONGODB_URI thiếu (xem server/config/db.js)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/photobooth?retryWrites=true&w=majority
# NODE_ENV=development
