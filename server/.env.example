# Chép thành server/.env và điền giá trị
# PORT của backend (HTTP)
PORT=3000

# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy (không dấu cách đầu)
# Ví dụ dev: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Để trống (không đặt) = cho phép mọi origin (chỉ dùng môi trường dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# (Giai đoạn sau - chưa dùng ở khung MVP này, giữ lại để nhớ: database chưa kết nối)
# MONGODB_URI=mongodb://localhost:27017/photobooth
# NODE_ENV=development
